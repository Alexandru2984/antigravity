# ── Required secrets (must set these) ─────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
POSTGRES_PASSWORD=replace_with_32_plus_random_chars
MONGO_PASSWORD=replace_with_32_plus_random_chars
MINIO_ROOT_USER=replace_with_random_admin_user
MINIO_ROOT_PASSWORD=replace_with_32_plus_random_chars
NEO4J_PASSWORD=replace_with_32_plus_random_chars
OPENSEARCH_INITIAL_ADMIN_PASSWORD=replace_with_32_plus_random_chars
SECRET_KEY_BASE=replace_with_openssl_rand_hex_64
ADMIN_SECRET_KEY_BASE=replace_with_openssl_rand_hex_64
REVIEW_APP_KEY=base64:replace_with_laravel_key_generate_output
INTERNAL_SERVICE_TOKEN=replace_with_32_plus_random_chars

# ── Public edge ───────────────────────────────────────────────
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ── Frontend ───────────────────────────────────────────────────
FRONTEND_URL=https://polyglot.micutu.com
CORS_ORIGINS=https://polyglot.micutu.com

# ── Demo mesh controls ─────────────────────────────────────────
POLYGLOT_MESH_ENABLED=false
POLYGLOT_MESH_MAX_CONCURRENCY=2
IMAGE_PUBLIC_PATH_PREFIX=/api/v1/images

# ── JWT keys are generated automatically by deploy.sh ─────────
# You can override by setting:
# JWT_PRIVATE_KEY=<PEM content>
# JWT_PUBLIC_KEY=<PEM content>
