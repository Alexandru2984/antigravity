# ── Required secrets (must set these) ─────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
POSTGRES_PASSWORD=supersecret
SECRET_KEY_BASE=generate_with_openssl_rand_-hex_64

# ── Optional — defaults work for local Dev ─────────────────────
MONGO_PASSWORD=polymarket
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
NEO4J_PASSWORD=neo4j
REVIEW_APP_KEY=base64:changeme
ADMIN_SECRET_KEY_BASE=changeme_in_production

# ── Frontend ───────────────────────────────────────────────────
FRONTEND_URL=https://polymarket.example.com

# ── JWT keys are generated automatically by deploy.sh ─────────
# You can override by setting:
# JWT_PRIVATE_KEY=<PEM content>
# JWT_PUBLIC_KEY=<PEM content>
