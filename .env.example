# ============================================================
# PolyMarket — Environment Variables Template
# Copy to .env and fill in real values
# NEVER commit .env to git!
# ============================================================

# ── Stripe ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ── JWT Keys (generate with: openssl genrsa -out jwt_private.pem 4096)
# For local dev, place keys in infra/secrets/ (gitignored)
JWT_PRIVATE_KEY_PATH=./infra/secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./infra/secrets/jwt_public.pem

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=polymarket
POSTGRES_PASSWORD=polymarket_dev

# ── MongoDB ─────────────────────────────────────────────────
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=polymarket
MONGO_PASSWORD=polymarket_dev
MONGO_DB=polymarket

# ── MySQL ───────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=polymarket
MYSQL_PASSWORD=polymarket_dev
MYSQL_DB=polymarket_reviews

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://:polymarket_dev@localhost:6379

# ── ClickHouse ──────────────────────────────────────────────
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=polymarket
CLICKHOUSE_PASSWORD=polymarket_dev
CLICKHOUSE_DB=polymarket_analytics

# ── OpenSearch ──────────────────────────────────────────────
OPENSEARCH_URL=http://localhost:9200

# ── TimescaleDB ─────────────────────────────────────────────
TIMESCALE_URL=jdbc:postgresql://localhost:5433/polymarket_metrics
TIMESCALE_USER=polymarket
TIMESCALE_PASSWORD=polymarket_dev

# ── Neo4j ───────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=polymarket_dev

# ── SurrealDB ───────────────────────────────────────────────
SURREALDB_URL=ws://localhost:8000/rpc
SURREALDB_USER=polymarket
SURREALDB_PASS=polymarket_dev
SURREALDB_NS=polymarket
SURREALDB_DB=feed

# ── Kafka ───────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092

# ── MinIO ───────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=miniominio
MINIO_USE_SSL=false

# ── OpenTelemetry ───────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_VERSION=0.1.0

# ── Service URLs (local dev) ─────────────────────────────────
AUTH_SERVICE_URL=http://localhost:4001
LISTING_SERVICE_URL=http://localhost:4002
SEARCH_SERVICE_URL=http://localhost:4003
IMAGE_SERVICE_URL=http://localhost:4004
NOTIFICATION_SERVICE_URL=http://localhost:4005
PAYMENT_SERVICE_URL=http://localhost:4006
PROFILE_SERVICE_URL=http://localhost:4007
FEED_SERVICE_URL=http://localhost:4008
REVIEW_SERVICE_URL=http://localhost:4009
ANALYTICS_SERVICE_URL=http://localhost:4010
CHAT_SERVICE_URL=http://localhost:4011

# ── Rails ───────────────────────────────────────────────────
RAILS_MASTER_KEY=your_rails_master_key_here

# ── Next.js frontend ─────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_STRIPE_PK=pk_test_your_stripe_publishable_key_here
