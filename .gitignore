# ===========================
# PolyMarket — .gitignore
# Covers: TypeScript, Elixir, Rust, Java, C++, C#, Kotlin, Go,
#         PHP, Python, Scala, F#, Haskell, Ruby, Zig, C
# ===========================

# ── Secrets / ENV ─────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.development
.env.production
!.env.example
*.key
*.pem
secrets/
# Allow ONLY the SOPS-encrypted secrets file to be committed; the age private
# key lives outside the repo (~/.config/sops/age/keys.txt) so this is safe.
!deploy/secrets/
deploy/secrets/*
!deploy/secrets/secrets.env
!deploy/secrets/vault-bootstrap.env
infra/keys/
infra/nginx/ssl/

# ── Node.js / TypeScript ─────────────────────────────────────
node_modules/
dist/
.next/
.turbo/
*.tsbuildinfo
coverage/
.cache/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Elixir / Mix ─────────────────────────────────────────────
_build/
deps/
*.beam
.elixir_ls/
.fetch
priv/plts/
*.ez

# ── Rust ──────────────────────────────────────────────────────
target/
*.rlib

# ── Java / Maven / Gradle ────────────────────────────────────
*.class
*.jar
*.war
*.ear
.gradle/
build/
out/
*.iml
.idea/

# ── C++ / CMake ──────────────────────────────────────────────
CMakeCache.txt
CMakeFiles/
cmake-build-*/
*.o
*.a
*.so
*.dylib
*.exe
Makefile.in

# ── C# / .NET ────────────────────────────────────────────────
bin/
obj/
*.user
*.suo
*.csproj.user
*.fsproj.user
packages/
*.nupkg
.vs/

# ── Kotlin / Gradle ──────────────────────────────────────────
.kotlin/
*.gradle
local.properties

# ── Go ────────────────────────────────────────────────────────
*.test
vendor/
go.sum.bak

# ── PHP / Composer ────────────────────────────────────────────
composer.lock
!services/review-service/composer.lock
.phpunit.result.cache
storage/logs/
public/storage
bootstrap/cache/*.php

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── Scala / SBT ──────────────────────────────────────────────
.bsp/
.metals/
.bloop/
project/target/
project/project/

# ── Haskell / Stack / Cabal ──────────────────────────────────
.stack-work/
dist-newstyle/
*.hi
*.dyn_hi
*.dyn_o
.cabal-sandbox/
cabal.sandbox.config

# ── Ruby / Bundler ────────────────────────────────────────────
.bundle/
vendor/bundle/
Gemfile.lock
!services/admin-panel/Gemfile.lock
*.gem
db/*.sqlite3
db/*.sqlite3-journal
log/
tmp/
storage/

# ── Zig ───────────────────────────────────────────────────────
zig-out/
zig-cache/
.zig-cache/
*.wasm.map

# ── Docker ────────────────────────────────────────────────────
.docker/
docker-compose.override.yml

# ── OS / Editor ──────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~
\#*\#
.project
.classpath
.settings/

# ── Misc ─────────────────────────────────────────────────────
*.log
*.tmp
*.bak
*.orig
*.pid
*.seed

# ── Review service Laravel runtime directories ───────────────
!services/review-service/storage/
!services/review-service/storage/framework/
!services/review-service/storage/framework/cache/
!services/review-service/storage/framework/cache/data/
!services/review-service/storage/framework/sessions/
!services/review-service/storage/framework/views/
!services/review-service/storage/logs/
!services/review-service/storage/**/.gitkeep
