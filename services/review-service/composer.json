{
    "name": "polymarket/review-service",
    "type": "project",
    "description": "Review service for PolyMarket — PHP 8.3 / Laravel 11 / MySQL",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^11.0",
        "laravel/tinker": "^2.9",
        "mateusjunges/laravel-kafka": "^1.14",
        "open-telemetry/sdk": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "start": ["php artisan serve --host=0.0.0.0 --port=4009"],
        "test": ["phpunit"]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "platform": {"php": "8.3"}
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
